{
  "action": {
    "default_title": "云记事本",
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "多条纯文本笔记（侧边栏常驻），自动同步到 Cloudflare",
  "host_permissions": [
    "https://notepad-sync.example.workers.dev/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "云记事本",
  "options_page": "options.html",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel"
  ],
  "version": "1.2.0",
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}